aws_region = "ap-south-2"
profile = "hi" ##default profile name for your aws
eks_admin_user_arns = ["arn:aws:iam::1234567890:root"]   #this controlls who gets the ading access to the cluster
vpc_cidr =  "10.0.0.0/16" 
env = "test"   #name of your environment
name = "run"   #name of your project
zones_public = ["ap-south-2a","ap-south-2b"]
public_subnets = ["10.0.1.0/24", "10.0.2.0/24"]
public_ip = [true,false]  # assignment of public ip to the subnets respectively
private_subnets = ["10.0.100.0/24", "10.0.101.0/24"]
zones_private = ["ap-south-2b","ap-south-2c"]
dns_hostname = true
dns_support = true
domain  = "xyz.com"   #doamin n,e for the load balancer and certificate genaratation
cluster_version = "1.34"
node_instance_types = ["t4g.small"]     #arm cpu used
node_ami_type = "AL2023_ARM_64_STANDARD"  #arm image used
node_min_size = 1
node_max_size = 2
node_desired_size = 1
node_max_unavailable = 1